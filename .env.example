# ─── YouCam API ──────────────────────────────────────────────────────────
# Each team member uses THEIR OWN key. The rate limit (250 requests / 300 s)
# is per token, so separate keys do not throttle each other while developing.
#
# ⚠️ This variable deliberately has NO NEXT_PUBLIC_ prefix: the key must never
#    reach the browser. Every YouCam call goes through server route handlers.
#    Put the real value in .env.local (gitignored), never in this file.
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# ─── Mock mode ───────────────────────────────────────────────────────────
# true  = YouCam is not called, fixtures are returned. Spends NO units.
# false = real calls.
YOUCAM_MOCK=true

# ─── MCP servers (for reference — the app reads them from src/core/mcp/client.ts)
YOUCAM_MCP_BEAUTY=https://mcp-api-01.makeupar.com/mcp/beauty
YOUCAM_MCP_FASHION=https://mcp-api-01.makeupar.com/mcp/fashion
YOUCAM_MCP_CREATORS=https://mcp-api-01.makeupar.com/mcp/creators

# ─── LLM (optional, ONLY for F17 · see docs/04-LLM-POLICY.md) ────────────
# An LLM may DRAFT, never DECIDE. No figure, colour, name or verdict comes out
# of a language model: our user cannot detect a hallucination. If one is used,
# it runs with a spend cap and a deterministic fallback.
# LLM_API_KEY=

# ─── THERE IS NO DATABASE ────────────────────────────────────────────────
# The wardrobe and the profile live in IndexedDB, in the user's browser.
# No accounts, no login, no external service. The app starts empty on
# purpose: every colour on screen is measured from the user's own photos.
