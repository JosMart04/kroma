# ─── YouCam API ──────────────────────────────────────────────────────────
# Cada miembro usa SU PROPIA key. Son 1.000 unidades por persona y el rate
# limit es por token: 4 keys distintas = 4x de techo efectivo.
#
# ⚠️ Esta variable NO lleva prefijo NEXT_PUBLIC_ a propósito: la clave nunca
#    debe llegar al navegador. Todas las llamadas a YouCam pasan por route
#    handlers en el servidor.
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# ─── Modo mock ───────────────────────────────────────────────────────────
# true  = no se llama a YouCam, se devuelven fixtures. NO consume unidades.
# false = llamadas reales.
YOUCAM_MOCK=true

# ─── MCP (solo P1) ───────────────────────────────────────────────────────
YOUCAM_MCP_BEAUTY=https://mcp-api-01.makeupar.com/mcp/beauty
YOUCAM_MCP_FASHION=https://mcp-api-01.makeupar.com/mcp/fashion
YOUCAM_MCP_CREATORS=https://mcp-api-01.makeupar.com/mcp/creators

# ─── LLM (opcional, SOLO para F17 · ver docs/04-POLITICA-LLM.md) ─────────
# Un LLM puede REDACTAR, nunca DECIDIR. Ninguna cifra, color, nombre ni
# veredicto sale de un modelo de lenguaje: nuestro usuario no puede detectar
# una alucinación. Si se usa, va con tope de gasto y fallback determinista.
# LLM_API_KEY=

# ─── NO HAY BASE DE DATOS ────────────────────────────────────────────────
# El armario y el perfil viven en IndexedDB, en el navegador del usuario.
# Sin cuentas, sin login, sin servicio externo. Un juez abre el enlace y
# encuentra la app funcionando con un armario ya cargado (datos semilla).
